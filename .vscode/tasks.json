{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build debug exe",
            "command": "C:/bin/w64devkit/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c23",
                "-g",
                "-o",
                "main.exe",
                "src/main.c",
                "-Iinclude",
                "-Llib",
                "-lraylib",
                "-lgdi32",
                "-lwinmm",
                "-lumka",
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        }
    ],
    "version": "2.0.0"
}