type Color* = struct {r, g, b, a: uint8}

type MouseButton* = enum {
    MOUSE_BUTTON_LEFT    = 0;
    MOUSE_BUTTON_RIGHT   = 1;
    MOUSE_BUTTON_MIDDLE  = 2;
    MOUSE_BUTTON_SIDE    = 3;
    MOUSE_BUTTON_EXTRA   = 4;
    MOUSE_BUTTON_FORWARD = 5;
    MOUSE_BUTTON_BACK    = 6;
}

fn drawText*(text: str, posX, posY, fontSize: int32, color: Color)
fn drawRectangle*(posX, posY, width, height: int32, color: Color)
fn isMouseButtonPressed*(button: MouseButton): bool
fn getMouseX*(): int32
fn getMouseY*(): int32