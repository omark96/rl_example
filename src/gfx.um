import "core.um"

type Color* = struct {r, g, b, a: uint8}
type Texture* = struct {_: uint}
type RenderTexture* = struct {_: uint}
type Model* = struct {_: uint}
type Vector3* = struct {
    x: real32
    y: real32
    z: real32
}

type Camera* = struct {
    position: Vector3
    target: Vector3
    up: Vector3
    fovy: real32
    projection: int32
}

type CameraMode* = enum {
    CUSTOM = 0;              // Camera custom, controlled by user (UpdateCamera() does nothing)
    FREE;                    // Camera free mode
    ORBITAL;                 // Camera orbital, around target, zoom supported
    FIRST_PERSON;            // Camera first person
    THIRD_PERSON;             // Camera third person
}


fn drawText*(text: str, posX, posY, fontSize: int32, color: Color)
fn drawRectangle*(posX, posY, width, height: int32, color: Color)
fn drawGrid*(slices: int32, spacing: real32)
fn loadTexture*(filename: str): Texture
fn unloadTexture*(texture: Texture)
fn drawTexture*(texture: Texture, x, y: int32, tint: Color)
fn loadModel*(fileName: str): Model
fn drawModel*(model: Model, position: Vector3, scale: real32, color: Color)
fn replaceTextureOnModel*(model: Model, materialIndex: int32, texture: Texture)
fn beginMode3D*(camera: Camera)
fn endMode3D*()
fn drawTexQuad*(texture: Texture, pos, right, up: Vector3, flipY: bool, tint: Color)
fn updateCamera*(camera: ^Camera, mode: CameraMode)
fn getGameScreen*(game: core::Game): RenderTexture
fn getGameScreenTexture*(screen: RenderTexture): Texture
fn clearBackground*(color: Color)