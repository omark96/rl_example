type MouseButton* = enum {
    MOUSE_BUTTON_LEFT    = 0;
    MOUSE_BUTTON_RIGHT   = 1;
    MOUSE_BUTTON_MIDDLE  = 2;
    MOUSE_BUTTON_SIDE    = 3;
    MOUSE_BUTTON_EXTRA   = 4;
    MOUSE_BUTTON_FORWARD = 5;
    MOUSE_BUTTON_BACK    = 6;
}


type KeyboardKey* = enum {
    KEY_ZERO = 48;
    KEY_ONE = 49;
    KEY_TWO = 50;
    KEY_THREE = 51;
    KEY_FOUR = 52;
    KEY_FIVE = 53;
    KEY_SIX = 54;
    KEY_SEVEN = 55;
    KEY_EIGHT = 56;
    KEY_NINE = 57;
    KEY_A = 65;
}

fn isMouseButtonPressed*(button: MouseButton): bool
fn getMouseX*(): int32
fn getMouseY*(): int32

fn isKeyPressed*(key: KeyboardKey): bool