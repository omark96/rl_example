type MouseButton* = enum {
    LEFT    = 0;
    RIGHT   = 1;
    MIDDLE  = 2;
    SIDE    = 3;
    EXTRA   = 4;
    FORWARD = 5;
    BACK    = 6;
}


type KeyboardKey* = enum {
    KEY_ZERO = 48;
    KEY_ONE = 49;
    KEY_TWO = 50;
    KEY_THREE = 51;
    KEY_FOUR = 52;
    KEY_FIVE = 53;
    KEY_SIX = 54;
    KEY_SEVEN = 55;
    KEY_EIGHT = 56;
    KEY_NINE = 57;
    KEY_A = 65;

    KEY_LEFT_SHIFT = 340
    KEY_LEFT_CONTROL = 341
    KEY_LEFT_ALT = 342
    KEY_LEFT_SUPER = 343
    KEY_RIGHT_SHIFT = 344
    KEY_RIGHT_CONTROL = 345
    KEY_RIGHT_ALT = 346
    KEY_RIGHT_SUPER = 347
}

fn isMouseButtonPressed*(button: MouseButton): bool
fn getMouseX*(): int32
fn getMouseY*(): int32

fn disableCursor*()
fn enableCursor*()

fn isKeyPressed*(key: KeyboardKey): bool