import (
    "gfx.um"
    "input.um"
    "core.um"
)

type State = struct {
    games: []core::Game
    screens: []gfx::RenderTexture
    terminal: gfx::Model
    camera: gfx::Camera

}

var state: State = {}

fn hotReload(): ^State{
    return &state
}

fn init() {
    game := core::registerGame("example")
    state.games = append(state.games, game)
    
    game2 := core::registerGame("example3")
    state.games = append(state.games, game2)

    camera := gfx::Camera{}
    camera.position = {0, 1, 2}
    camera.up = {0, 1, 0}
    camera.target = {4, 1, 0}
    camera.fovy = 45
    camera.projection = 0
    state.camera = camera

    state.terminal = gfx::loadModel("defaultAssets/terminal.gltf")

    input::disableCursor();
}

fn update() {
}

fn input() {
    gfx::updateCamera(&state.camera, .FIRST_PERSON)
    if input::isKeyPressed(.KEY_ONE){
        core::setActiveGame(state.games[0])
    }
    if input::isKeyPressed(.KEY_ZERO){
        parentHandle := core::getParentGame()
        core::setActiveGame(parentHandle)
    }
    if input::isMouseButtonPressed(.LEFT) {
        input::disableCursor();
    }
}

fn drawTerminal(game: core::Game, pos: gfx::Vector3) {
    screen := gfx::getGameScreen(game)
    texture := gfx::getGameScreenTexture(screen);
    gfx::replaceTextureOnModel(state.terminal, 2, texture)
    gfx::drawModel(state.terminal, pos, 1.0/6.0, {255, 255, 255, 255})
}

fn draw() {
    gfx::clearBackground({30, 200, 30, 255})
    gfx::beginMode3D(state.camera)
    gfx::drawGrid(100, 1)
    
    for i, game in state.games {
        drawTerminal(game, {3 * i, 0, 0})
    }

    gfx::endMode3D()
}


