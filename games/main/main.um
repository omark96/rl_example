import (
    "gfx.um"
    "input.um"
    "core.um"
)

type State = struct {
    games: []core::Game
    screens: []gfx::RenderTexture
    terminal: gfx::Model
    camera: gfx::Camera
}

var state: State = {}

fn hotReload(): ^State{
    return &state
}

fn init() {
    game := core::registerGame("example2")
    state.games = append(state.games, game)
    camera := gfx::Camera{}
    camera.position = {0, 1, 2}
    camera.up = {0, 1, 0}
    camera.target = {4, 1, 0}
    camera.fovy = 45
    camera.projection = 0
    state.camera = camera

    state.terminal = gfx::loadModel("defaultAssets/terminal.gltf")
}

fn update() {
}

fn input() {
    if core::currentGameState() == .ACTIVE{
        gfx::updateCamera(&state.camera, .FIRST_PERSON)
        if input::isKeyPressed(.KEY_ONE){
            core::setActiveGame(state.games[0])
        }
        if input::isMouseButtonPressed(.LEFT) {
            input::disableCursor()
        }
        if input::isKeyPressed(.KEY_LEFT_CONTROL){
            input::enableCursor()
        }
    }
    
}

fn draw() {
    gfx::clearBackground({120, 167, 255, 255})
    gfx::beginMode3D(state.camera)
    gfx::drawGrid(100, 1)
    screen := gfx::getGameScreen(state.games[0])
    texture := gfx::getGameScreenTexture(screen);
    gfx::replaceTextureOnModel(state.terminal, 2, texture)
    gfx::drawModel(state.terminal, {3, 0, 0}, 1.0/6.0, {255, 255, 255, 255})
    gfx::endMode3D()
}


