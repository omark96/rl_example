import (
    "gfx.um"
    "input.um"
    "core.um"
)

type State = struct {
    games: []core::Game
    screens: []gfx::RenderTexture
    camera: gfx::Camera

}

var state: State = {}

fn hotReload(): ^State{
    return &state
}

fn init() {
    game := core::registerGame("example")
    state.games = append(state.games, game)
    camera := gfx::Camera{}
    camera.position = {0, 1, 2}
    camera.up = {0, 1, 0}
    camera.target = {4, 1, 0}
    camera.fovy = 45
    camera.projection = 0
    state.camera = camera
}

fn update() {
    gfx::updateCamera(&state.camera, .CAMERA_FREE)
}

fn input() {
}

fn draw() {
    gfx::beginMode3D(state.camera)
    screen := gfx::getGameScreen(state.games[0])
    texture := gfx::getGameScreenTexture(screen);
    gfx::drawTexQuad(texture, {0, 0, 0}, {1, 0, 0}, {0, 0.5625, 0}, true, {255, 255, 255, 255})
    gfx::endMode3D()
}


