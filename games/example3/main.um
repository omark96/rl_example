import (
    "gfx.um"
    "input.um"
    "core.um"
    nui = "dir/nodeui.um"
    "sdf.um"
)

type State = struct {
    node: nui::Node
}

var state: State = {
}

fn hotReload(): ^State{
    return &state
}

fn init() {
    state.node = {200, 200, 400, 300}
    sdf::loadFont("FiraSans")
}

fn update() {
}

fn input() {
    input::enableCursor()
    if input::isKeyPressed(.KEY_ZERO){
        parentHandle := core::getParentGame()
        core::setActiveGame(parentHandle)
    }
}

fn draw() {
    gfx::clearBackground({20, 20, 20, 255})
    sdf::beginSdfMode()

    state.node.draw()
    sdf::drawLine({800, 100}, {1000, 200}, 20, {200, 50, 50, 255})
    sdf::drawCircle({1000, 400}, 200, {50, 150, 50, 255})
    sdf::endSdfMode()
    gfx::drawText("Example3", 10, 100, 20, {220, 220 ,202 , 255})
}


