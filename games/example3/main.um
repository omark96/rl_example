import (
    "gfx.um"
    "input.um"
    "core.um"
    slib = "dir/some_lib.um"
)

type State = struct {
}

var state: State = {}

fn hotReload(): ^State{
    return &state
}

fn init() {
}

fn update() {
    slib::printEight();
}

fn input() {
    input::enableCursor()
    if input::isKeyPressed(.KEY_ZERO){
        parentHandle := core::getParentGame()
        core::setActiveGame(parentHandle)
    }
}

fn draw() {
    gfx::clearBackground({220, 220, 220, 255})
    gfx::drawText("Example3", 10, 100, 20, {0, 0 ,0 , 255})
}


